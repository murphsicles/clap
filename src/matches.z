// @cli/clap::matches — Parsed argument values.
//
// ArgMatches provides access to the parsed values after Command::get_matches().
// Values are stored in dense arrays for fast lookup by ID.

use std::option::Option;
use std::string::String;
use std::vec::Vec;

/// The result of parsing command-line arguments.
///
/// Provides access to flag values, options, positional args, and subcommands.
///
/// # Example
/// ```
/// let matches = cmd.get_matches();
/// let config: Option<&str> = matches.get_one("config");
/// let verbose: bool = matches.get_flag("verbose");
/// if let Some((name, sub_m)) = matches.subcommand() {
///     // handle subcommand
/// }
/// ```
pub struct ArgMatches {
    /// Stored values keyed by arg ID.
    /// Each ID maps to a list of string values (for Append/multiple).
    values: Vec<(String, Vec<String>)>,

    /// Boolean/count values stored separately for fast access.
    flags: Vec<(String, u64)>,

    /// Whether help was requested (--help or -h was passed)
    help_requested: bool,

    /// Whether version was requested (--version or -V was passed)
    version_requested: bool,

    /// Subcommand matches, if any
    subcommand: Option<(String, Box<ArgMatches>)>,

    /// Extra arguments after --
    trailing: Vec<String>,
}

impl ArgMatches {
    /// Creates a new empty ArgMatches.
    pub fn new() -> Self {
        ArgMatches {
            values: Vec::new(),
            flags: Vec::new(),
            help_requested: false,
            version_requested: false,
            subcommand: Option::None,
            trailing: Vec::new(),
        }
    }

    // ── Internal setters (called by Command during parsing) ──

    pub fn set_value(&mut self, id: &str, val: impl Into<String>) {
        let val: String = val.into();
        // Find existing entry or create new one
        let mut found = false;
        for (key, vals) in &mut self.values {
            if key == id {
                vals.push(val);
                found = true;
                break;
            }
        }
        if !found {
            self.values.push((id.to_string(), vec![val]));
        }
    }

    pub fn set_flag_count(&mut self, id: &str, count: u64) {
        let mut found = false;
        for (key, val) in &mut self.flags {
            if key == id {
                *val = count;
                found = true;
                break;
            }
        }
        if !found {
            self.flags.push((id.to_string(), count));
        }
    }

    pub fn increment_flag(&mut self, id: &str) {
        let mut found = false;
        for (key, val) in &mut self.flags {
            if key == id {
                *val += 1;
                found = true;
                break;
            }
        }
        if !found {
            self.flags.push((id.to_string(), 1));
        }
    }

    pub fn set_help(&mut self) { self.help_requested = true; }
    pub fn set_version(&mut self) { self.version_requested = true; }

    pub fn set_subcommand(&mut self, name: &str, matches: ArgMatches) {
        self.subcommand = Option::Some((name.to_string(), Box::new(matches)));
    }

    pub fn add_trailing(&mut self, val: impl Into<String>) {
        self.trailing.push(val.into());
    }

    // ── Public accessors ──

    /// Gets a single value for a named argument.
    /// Returns `None` if the argument was not provided or has no value.
    pub fn get_one(&self, id: &str) -> Option<&str> {
        for (key, vals) in &self.values {
            if key == id {
                if vals.is_empty() {
                    return Option::None;
                }
                return Option::Some(&vals[0]);
            }
        }
        Option::None
    }

    /// Gets all values for a multi-valued argument.
    /// Returns empty vec if not present.
    pub fn get_many(&self, id: &str) -> Vec<&str> {
        let mut result = Vec::new();
        for (key, vals) in &self.values {
            if key == id {
                for v in vals {
                    result.push(v.as_str());
                }
                break;
            }
        }
        result
    }

    /// Returns true if the flag/argument was present.
    pub fn contains_id(&self, id: &str) -> bool {
        for (key, _) in &self.values {
            if key == id { return true; }
        }
        for (key, _) in &self.flags {
            if key == id { return true; }
        }
        false
    }

    /// Gets a boolean flag value. Returns true if the flag was set.
    pub fn get_flag(&self, id: &str) -> bool {
        for (key, val) in &self.flags {
            if key == id { return *val > 0; }
        }
        false
    }

    /// Gets a count value (for -vvv). Returns 0 if not present.
    pub fn get_count(&self, id: &str) -> u64 {
        for (key, val) in &self.flags {
            if key == id { return *val; }
        }
        0
    }

    /// Returns true if --help or -h was passed.
    pub fn help_requested(&self) -> bool { self.help_requested }

    /// Returns true if --version or -V was passed.
    pub fn version_requested(&self) -> bool { self.version_requested }

    /// Gets the subcommand name and its matches, if any.
    pub fn subcommand(&self) -> Option<(&str, &ArgMatches)> {
        match &self.subcommand {
            Option::Some((name, m)) => Option::Some((name.as_str(), m.as_ref())),
            Option::None => Option::None,
        }
    }

    /// Gets trailing arguments after --.
    pub fn trailing(&self) -> &[String] { &self.trailing }

    /// Returns the number of positional/value args provided.
    pub fn value_count(&self) -> u32 {
        let mut count: u32 = 0;
        for (_, vals) in &self.values {
            count += vals.len() as u32;
        }
        count
    }
}
